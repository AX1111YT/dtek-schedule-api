# HTTP server
HOST=127.0.0.1
PORT=8000

# Comma-separated IPs or CIDRs allowed to send trusted X-Forwarded-For headers.
FORWARDED_ALLOW_IPS=127.0.0.1

# Leave empty to disable API-key authentication for local use.
API_KEY=

# Rate-limit API routes by client IP. RATE_LIMIT uses SlowAPI syntax, such as 60/minute.
RATE_LIMIT_ENABLED=true
RATE_LIMIT=30/minute

# Disable Swagger UI and the OpenAPI schema in production if they are not needed.
DOCS_ENABLED=false

# DTEK request and in-memory cache settings
UPSTREAM_TIMEOUT_SECONDS=15
SCHEDULE_CACHE_TTL_SECONDS=600
SCHEDULE_CACHE_STALE_SECONDS=3600
LOCATION_CACHE_TTL_SECONDS=3600
LOCATION_CACHE_STALE_SECONDS=86400
CACHE_MAX_ENTRIES=64
